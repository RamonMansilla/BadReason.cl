# Copiar a .env.local. Nunca subir credenciales a Git.
PAYMENT_MODE=sandbox
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SECRET=
PUBLIC_ORIGIN=
# Definir costo final del despacho en CLP. 0 solo si ofreces envío gratis.
SHIPPING_CLP=
MP_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Datos públicos del comercio, nunca contraseñas bancarias.
TRANSFER_DETAILS=
MP_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_ID=
