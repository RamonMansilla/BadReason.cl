# Copiar a .env.local. Nunca subir credenciales a Git.
PAYMENT_MODE=sandbox
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SECRET=
PUBLIC_ORIGIN=
# Tarifa en CLP hasta un subtotal de $50.000. Sobre ese monto el despacho es gratis.
SHIPPING_CLP=6000
MP_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Datos públicos del comercio, nunca contraseñas bancarias.
TRANSFER_DETAILS=
MP_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_ID=
