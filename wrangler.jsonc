{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "badreason",
  "main": "./functions/worker.mjs",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "SHIPPING_CLP": "6000" },
  "d1_databases": [
    {
      "binding": "PAYMENTS_DB",
      "database_name": "badreason-payments",
      "database_id": "7c2143df-a8c0-41e0-b4a6-74a11f24dbe8"
    }
  ],
  "keep_vars": true,
  "observability": { "enabled": true }
}
